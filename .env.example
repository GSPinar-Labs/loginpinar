# GSPinar SSO — Variables de entorno

# === Database (Turso / libSQL) ===
# URL de la base de datos Turso. Para desarrollo local puedes usar: file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# === Email ===
# Primario: SendPulse API (OAuth2) — funciona en Workers y Node.js
# Fallback: SMTP real vía nodemailer — solo Node.js local
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
EMAIL_FROM=noreply@gruposcoutpinar.com

# SMTP (solo como fallback si SendPulse no está configurado)
# SMTP_HOST=smtp-pulse.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# === Admin ===
# Correo electrónico que identifica a los administradores
ADMIN_EMAIL=web@gruposcoutpinar.com

# === Seguridad ===
JWT_SECRET=
CRON_SECRET=

# Token para el servidor MCP de gestión de miembros (/api/mcp)
MCP_SECRET=

# === OIDC / SSO ===
OIDC_CLIENT_ID=google-workspace
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://login.gspinar.com
APP_URL=https://login.gspinar.com
GOOGLE_REDIRECT_URI=https://accounts.google.com/oidcrp/03ys488c32tw7pc/cb

# Límite de intentos OTP antes de bloqueo temporal
MAX_OTP_ATTEMPTS=5

# Ruta de la BD SQLite (solo si DB_TYPE=sqlite)
# SQLITE_PATH=gspinar.db
