---
export interface Column {
  key: string
  label: string
  render?: (row: Record<string, unknown>) => string
}

export interface Props {
  columns: Column[]
  rows: Record<string, unknown>[]
  emptyMessage?: string
  class?: string
}

const { columns, rows, emptyMessage = "No hay datos disponibles." } = Astro.props
const extraClass = Astro.props.class || ""
---

<div class="table-wrapper {extraClass}">
  <table class="data-table">
    <thead>
      <tr>
        {columns.map(col => <th>{col.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.length === 0 ? (
        <tr><td colspan={columns.length} class="empty-row">{emptyMessage}</td></tr>
      ) : (
        rows.map(row => (
          <tr>
            {columns.map(col => (
              <td>{col.render ? col.render(row) : String(row[col.key] ?? '')}</td>
            ))}
          </tr>
        ))
      )}
    </tbody>
  </table>
</div>

<style>
.table-wrapper {
  background: white;
  border-radius: 0;
  box-shadow: 0 1px 4px rgba(0,0,0,0.07);
  overflow: hidden;
}
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}
.data-table thead th {
  background: #f5f5f7;
  padding: 0.7rem 0.9rem;
  text-align: left;
  font-weight: 600;
  color: #555;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  border-bottom: 2px solid #e8e8ed;
}
.data-table tbody td {
  padding: 0.7rem 0.9rem;
  border-bottom: 1px solid #f0f0f2;
}
.data-table tbody tr:last-child td {
  border-bottom: none;
}
.data-table tbody tr:hover {
  background: #fafafc;
}
.empty-row {
  text-align: center;
  color: #999;
  padding: 2rem 1rem !important;
}
</style>
