---
export interface Props {
    title?: string;
    class?: string;
    padding?: string;
}

const { title } = Astro.props;
const extraClass = Astro.props.class || "";
---

<div class={`card ${extraClass}`}>
    {title && <h2 class="card-title">{title}</h2>}
    <slot />
</div>

<style>
    .card {
        background: var(--gris-claro);
        border-radius: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        width: 100%;
        gap: 5px;
        margin: 1rem;
        padding: 1rem;
        p {
            margin: 0;
        }
    }

    .card-title {
        margin: 0 0 1rem 0;
        font-size: 1rem;
        font-weight: 600;
        color: #1d1d1f;
    }
</style>
